rules_version = '2';

// Public read (the portfolio site reads about/main and projects/*).
// Only the admin account can create, update and delete.
// Deploy: firebase deploy --only "storage,firestore:rules"
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'ismailisims1@gmail.com';
    }
  }
}
