rules_version = '2';

// Public read (images are served on the portfolio site).
// Only the admin account can create, update and delete.
// Deploy: firebase deploy --only "storage,firestore:rules"
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'ismailisims1@gmail.com';
    }
  }
}
